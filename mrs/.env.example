# ── MRS (Management Report System) 환경설정 예시 ──
# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 git 에 올리지 마세요)

# 기존 MariaDB 접속 정보 (MRS 는 mrs_ 접두어 테이블만 추가합니다)
MRS_DB_URL=mysql+pymysql://datanex8:PASSWORD@DB_HOST:3306/datanex8?charset=utf8mb4

# 기존 고객 테이블 매핑 (PMS 파트관리시스템의 pms_customers, 읽기 전용으로만 조회합니다)
MRS_LEGACY_CUSTOMER_TABLE=pms_customers
MRS_LEGACY_CUSTOMER_ID_COL=id
MRS_LEGACY_CUSTOMER_NAME_COL=name
MRS_LEGACY_CUSTOMER_ADDR_COL=address

# 서비스 경로 (https://www.datanex.io.kr/mms)
MRS_BASE_PATH=/mms
MRS_PUBLIC_URL=https://www.datanex.io.kr/mms

# 세션 서명 키 (임의의 긴 문자열)
MRS_SECRET_KEY=change-me-to-a-long-random-string

# 최초 관리자 계정 (최초 기동 시 1회 생성)
MRS_ADMIN_USERNAME=admin
MRS_ADMIN_PASSWORD=change-me

# 파일 저장 경로 (로그/보고서/양식)
MRS_DATA_DIR=./data

# Claude AI 진단 조언 – [시스템 설정] 화면에서도 입력 가능 (https://console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=
MRS_AI_MODEL=claude-opus-5-5

# 메일 발송 (SMTP) – 로그인 후 [시스템 설정] 화면에서 입력/변경할 수 있습니다(화면 값 우선).
MRS_SMTP_HOST=smtp.example.com
MRS_SMTP_PORT=587
MRS_SMTP_USER=
MRS_SMTP_PASSWORD=
MRS_SMTP_STARTTLS=true
MRS_MAIL_FROM=MRS <noreply@datanex.io.kr>

# 보고서에 표기되는 서비스 회사 정보 (시스템 설정 화면에서 변경 가능)
MRS_COMPANY_NAME=(주)데이터넥스
MRS_COMPANY_ADDRESS=서울시 구로구 디지털로34길 55 코오롱싸이언스밸리2차 1205호
# 보고서의 연락처/이메일은 보고서 담당 엔지니어(사용자 정보)의 값이 들어갑니다.
