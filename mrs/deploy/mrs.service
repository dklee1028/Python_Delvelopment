# /etc/systemd/system/mrs.service
[Unit]
Description=MRS - Management Report System (/mms)
After=network.target mariadb.service

[Service]
Type=simple
User=mrs
WorkingDirectory=/opt/mrs
EnvironmentFile=/opt/mrs/.env
ExecStart=/opt/mrs/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
