# api/index.php 만 외부에서 호출할 수 있습니다.
<FilesMatch "\.php$">
  <IfModule mod_authz_core.c>Require all denied</IfModule>
  <IfModule !mod_authz_core.c>Order allow,deny
  Deny from all</IfModule>
</FilesMatch>
<Files "index.php">
  <IfModule mod_authz_core.c>Require all granted</IfModule>
  <IfModule !mod_authz_core.c>Order deny,allow
  Allow from all</IfModule>
</Files>
