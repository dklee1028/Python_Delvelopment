# MRS — 설정 파일·데이터 폴더 외부 접근 차단
DirectoryIndex index.php
Options -Indexes
<FilesMatch "^(config\.php|database\.sql|README.*\.md|\.gitignore)$">
  <IfModule mod_authz_core.c>Require all denied</IfModule>
  <IfModule !mod_authz_core.c>Order allow,deny
  Deny from all</IfModule>
</FilesMatch>
AddType application/manifest+json .webmanifest
<IfModule mod_headers.c>
  <Files "sw.js">Header set Cache-Control "no-cache"</Files>
</IfModule>
